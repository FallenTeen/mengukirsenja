# Copy to `.env.local` and fill in from the Supabase dashboard (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin used for every link the server builds, most importantly the
# magic link redirect sent to customers. Must match the Supabase Site URL and the
# Redirect URLs allow-list. Use http://localhost:3000 locally and the deployed
# origin (no trailing slash) in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public studio WhatsApp number in international format, digits only (62...):
NEXT_PUBLIC_BUSINESS_WHATSAPP=
